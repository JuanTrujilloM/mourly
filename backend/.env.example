NODE_ENV=development
PORT=3001
DATABASE_URL="postgresql://user:password@localhost:5432/mourly"

# Auth
JWT_SECRET=change-me
# Access tokens are short-lived (15m, set in code); refresh tokens last this many days.
JWT_REFRESH_EXPIRES_DAYS=30
FRONTEND_URL=http://localhost:3000

# Email verification
EMAIL_CODE_TTL_MINUTES=10
MAIL_FROM="Mourly <no-reply@mourly.com>"
MAIL_REPLY_TO=cloud@mourly.com

# Email is limited to the verification code for now (university spam filters).
# Set to true to also send match, date and feedback notifications by email.
EMAIL_NOTIFICATIONS_ENABLED=false

# Availability links (HU-09) — how long the tokenized SMS link stays valid.
AVAILABILITY_LINK_TTL_HOURS=72

# Resend (HTTPS API, not SMTP — some hosts block outbound SMTP ports).
# Leave blank in dev to log verification codes and notification emails to
# the console instead of sending.
RESEND_API_KEY=

OPENAI_API_KEY=

# Chatbot (AI brain; no inbound transport yet)
# OpenRouter key — chat completions run through an OpenAI-compatible endpoint.
OPENROUTER_API_KEY=
CHATBOT_MODEL=openai/gpt-4o-mini
CHATBOT_REQUEST_TIMEOUT_MS=9000
CHATBOT_MEMORY_TTL_SECONDS=1800

# SMS notifications via Twilio (match invite link, date confirmation, feedback).
# Leave the credentials blank in dev to log each SMS to the console instead.
# Origin: a Messaging Service SID takes precedence over a plain sender number.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM=

# Admin venue-management access — comma-separated allowlist of admin emails
ADMIN_EMAILS=
