# Backend secrets. Copy to api.env on the VM and restrict it: chmod 600 api.env
# NODE_ENV and PORT are set in docker-compose.yml.

# Supabase pooler host (aws-0-us-east-2.pooler.supabase.com): the VM has no IPv6,
# and Supabase's direct host (db.<ref>.supabase.co) is IPv6-only.
DATABASE_URL=

JWT_SECRET=
JWT_REFRESH_EXPIRES_DAYS=30
FRONTEND_URL=https://mourly.com

EMAIL_CODE_TTL_MINUTES=10
MAIL_FROM="Mourly <no-reply@mourly.com>"
RESEND_API_KEY=

AVAILABILITY_LINK_TTL_HOURS=72

OPENAI_API_KEY=
OPENROUTER_API_KEY=
CHATBOT_MODEL=openai/gpt-4o-mini
CHATBOT_REQUEST_TIMEOUT_MS=9000
CHATBOT_MEMORY_TTL_SECONDS=1800

WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

ADMIN_EMAILS=
